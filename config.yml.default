token: "ENTER_YOUR_TOKEN"    # Lichess OAuth2 Token.
url: "https://lichess.org/"        # Lichess base URL.

engine:                            # Engine settings.
  dir: "./engines/MinMax/"                         # Current directory (where lichess-bot.py is)
  name: "play_uci.py"                   # Run the python interpreter
  interpreter: "python"
  working_dir: "./engines/MinMax/"                 # Read model files from current dir
  protocol: "uci"                  # "uci", "xboard" or "homemade"
  ponder: false                    # Think on opponent's time (disabled for simple bot)

polyglot:
  enabled: false                   # Activate polyglot book.
  book:
    standard:
      - engines/book1.bin
      - engines/book2.bin
  min_weight: 1
  selection: "weighted_random"
  max_depth: 20
  normalization: "none"

draw_or_resign:
  resign_enabled: false            # Whether or not the bot should resign.
  resign_score: -1000              # If score <= -1000 cp, resign.
  resign_for_egtb_minus_two: true
  resign_moves: 3
  offer_draw_enabled: true         # Whether or not the bot should offer/accept draw.
  offer_draw_score: 0
  offer_draw_for_egtb_zero: true
  offer_draw_moves: 10
  offer_draw_pieces: 10

online_moves:
  max_out_of_book_moves: 10
  max_retries: 2
  chessdb_book:
    enabled: false
    min_time: 20
    max_time: 10800
    move_quality: "good"
    min_depth: 20
  lichess_cloud_analysis:
    enabled: false
    min_time: 20
    max_time: 10800
    move_quality: "best"
    max_score_difference: 50
    min_depth: 20
    min_knodes: 0
  lichess_opening_explorer:
    enabled: false
    min_time: 20
    max_time: 10800
    source: "masters"
    player_name: ""
    sort: "winrate"
    min_games: 10
  online_egtb:
    enabled: false
    min_time: 20
    max_time: 10800
    max_pieces: 7
    source: "lichess"
    move_quality: "best"

lichess_bot_tbs:
  syzygy:
    enabled: false
    paths:
      - "engines/syzygy"
    max_pieces: 7
    move_quality: "best"
  gaviota:
    enabled: false
    paths:
      - "engines/gaviota"
    max_pieces: 5
    min_dtm_to_consider_as_wdl_1: 120
    move_quality: "best"

# No custom UCI options needed for your Python script yet
uci_options: {}

silence_stderr: false              # Keep false to see python errors in console

abort_time: 30                     # Time to abort a game in seconds when there is no activity.
fake_think_time: false             # Artificially slow down the bot.
rate_limiting_delay: 0
move_overhead: 2000                # Increase if your bot flags games too often.
max_takebacks_accepted: 0
quit_after_all_games_finish: false

correspondence:
  move_time: 60
  checkin_period: 300
  disconnect_time: 150
  ponder: false

challenge:
  concurrency: 1                   # Number of games to play simultaneously.
  sort_by: "best"
  preference: "none"
  accept_bot: true
  only_bot: false
  max_increment: 20
  min_increment: 0
  max_base: 300                    # Max 5 minutes (300s) base time. Increase if you want longer games.
  min_base: 0
  # max_days: 14                   # Commented out to allow Unlimited games
  min_days: 1
  variants:
    - standard
  time_controls:
    - bullet
    - blitz
    - rapid
    - classical
    - correspondence
  modes:
    - casual
    - rated
  bullet_requires_increment: false
  max_simultaneous_games_per_user: 5

greeting:
  hello: "Hi! I'm {me}. I am running a custom Python neural network trained by my owner. Good luck!"
  goodbye: "Good game!"
  hello_spectators: "Hi! I'm {me}."
  goodbye_spectators: "Thanks for watching!"

matchmaking:
  allow_matchmaking: false
  allow_during_games: false
  challenge_variant: "random"
  challenge_timeout: 30
  challenge_initial_time:
    - 60
    - 180
  challenge_increment:
    - 1
    - 2
  opponent_rating_difference: 300
  rating_preference: "none"
  challenge_mode: "random"
  challenge_filter: none
  include_challenge_block_list: false